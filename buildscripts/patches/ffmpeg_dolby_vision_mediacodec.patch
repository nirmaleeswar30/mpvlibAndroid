     }
 
     s->codec_name = ff_AMediaCodecList_getCodecNameByType(mime, profile, 0, avctx);
@@ -792,6 +799,13 @@ static int mediacodec_dec_get_video_codec(AVCodecContext *avctx, MediaCodecDecCo
         profile = -1;
         s->codec_name = ff_AMediaCodecList_getCodecNameByType(mime, profile, 0, avctx);
     }
+    if (!s->codec_name && !strcmp(mime, "video/dolby-vision")) {
+        s->codec_name = ff_AMediaCodecList_getCodecNameByType(mime, -1, 0, avctx);
+        if (!s->codec_name) {
+            s->codec_name = av_strdup("c2.qti.dv.decoder");
