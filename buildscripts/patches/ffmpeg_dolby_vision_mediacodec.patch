diff --git a/libavcodec/mediacodecdec.c b/libavcodec/mediacodecdec.c
index 0551370..8d3af5a 100644
--- a/libavcodec/mediacodecdec.c
+++ b/libavcodec/mediacodecdec.c
@@ -32,6 +32,7 @@
 #include "libavutil/intreadwrite.h"
 #include "libavutil/pixfmt.h"
 #include "libavutil/internal.h"
+#include "libavutil/dovi_meta.h"
 
 #include "avcodec.h"
 #include "codec_internal.h"
@@ -353,6 +354,26 @@ static av_cold int mediacodec_decode_init(AVCodecContext *avctx)
         ret = hevc_set_extradata(avctx, format);
         if (ret < 0)
             goto done;
+
+        for (int i = 0; i < avctx->nb_coded_side_data; i++) {
+            if (avctx->coded_side_data[i].type == AV_PKT_DATA_DOVI_CONF) {
+                const AVPacketSideData *sd = &avctx->coded_side_data[i];
+                if (sd->size >= sizeof(AVDOVIDecoderConfigurationRecord)) {
+                    const AVDOVIDecoderConfigurationRecord *dovi =
+                        (const AVDOVIDecoderConfigurationRecord *)sd->data;
+                    if (dovi->dv_profile == 5 || dovi->dv_profile == 8 || dovi->dv_profile == 7) {
+                        codec_mime = "video/dolby-vision";
+                        int dv_profile = (dovi->dv_profile == 5) ? 0x20 : 0x100;
+                        ff_AMediaFormat_setInt32(format, "profile", dv_profile);
+                        ff_AMediaFormat_setInt32(format, "level", 0x400);
+                        av_log(avctx, AV_LOG_INFO,
+                               "MediaCodec: Dolby Vision detected (profile %d) -> mime=%s, profile=0x%x\n",
+                               dovi->dv_profile, codec_mime, dv_profile);
+                    }
+                }
+                break;
+            }
+        }
         break;
 #endif
 #if CONFIG_MPEG2_MEDIACODEC_DECODER
diff --git a/libavcodec/mediacodecdec_common.c b/libavcodec/mediacodecdec_common.c
